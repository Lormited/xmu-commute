{
  "name": "xmuc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --localhost --port 1100",
    "web": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --web --host localhost --port 1100",
    "phone": "node --dns-result-order=ipv4first ./node_modules/expo/bin/cli start --go --lan --port 1100",
    "check": "tsc --noEmit && node --experimental-strip-types tests/selfcheck.mjs && node --experimental-strip-types tests/attendance-selfcheck.mjs && node --experimental-strip-types tests/learning-selfcheck.mjs && node --experimental-strip-types tests/schedule-selfcheck.mjs && node --experimental-strip-types tests/history-selfcheck.mjs && node --experimental-strip-types tests/school-cookies-selfcheck.mjs && node --experimental-strip-types tests/school-browser-selfcheck.mjs && node --experimental-strip-types tests/qr-camera-selfcheck.mjs && node --experimental-strip-types tests/notifications-selfcheck.mjs",
    "export:web": "expo export --platform web",
    "export:all": "expo export --platform all --output-dir dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@preeternal/react-native-cookie-manager": "7.0.0",
    "expo": "^58.0.22",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.29",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-background-actions": "4.1.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tough-cookie": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
